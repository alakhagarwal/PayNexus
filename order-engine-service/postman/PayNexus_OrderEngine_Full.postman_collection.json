          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/alerts/00000000-0000-0000-0000-000000000000"
          }
        },
        {
          "name": "12 - Verify Aarav alerts empty after cancel",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('No active TCS alert for Aarav', () => {",
                  "  const tcsAlert = pm.response.json().data.find(a => a.symbol === 'TCS');",
                  "  pm.expect(tcsAlert).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/alerts/{{aaravId}}"
