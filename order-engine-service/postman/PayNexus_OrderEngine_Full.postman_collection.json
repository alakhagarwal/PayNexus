          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/alerts/{{cancelId}}"
          }
        },
        {
          "name": "11 - Cancel Non-existent Alert (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('success is false', () => pm.expect(pm.response.json().success).to.be.false);",
                  "pm.test('message mentions Alert not found', () => pm.expect(pm.response.json().message).to.include('Alert not found'));"
                ]
