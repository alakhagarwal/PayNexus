    {
      "name": "Price Alerts Engine (Phase 2)",
      "description": "Endpoints for creating, querying, and cancelling price alerts with automated price threshold triggering",
      "item": [
        {
          "name": "1 - Create Alert (ABOVE - never triggers)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('success is true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('data.alertId exists', () => pm.expect(pm.response.json().data.alertId).to.be.a('string'));",
                  "pm.test('direction is ABOVE', () => pm.expect(pm.response.json().data.direction).to.equal('ABOVE'));",
                  "pm.test('isActive is true', () => pm.expect(pm.response.json().data.isActive).to.be.true);",
                  "pm.collectionVariables.set('alertId', pm.response.json().data.alertId);",
                  "pm.collectionVariables.set('cancelId', pm.response.json().data.alertId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/alerts",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{aaravId}}\",\n  \"symbol\": \"TCS\",\n  \"targetPrice\": 999999.00,\n  \"direction\": \"ABOVE\"\n}"
            }
          }
        },
        {
          "name": "2 - Create Alert (BELOW - auto-triggers immediately)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('success is true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('symbol is RELIANCE', () => pm.expect(pm.response.json().data.symbol).to.equal('RELIANCE'));",
                  "pm.test('direction is BELOW', () => pm.expect(pm.response.json().data.direction).to.equal('BELOW'));",
                  "pm.collectionVariables.set('triggerAlertId', pm.response.json().data.alertId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/alerts",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{priyaId}}\",\n  \"symbol\": \"RELIANCE\",\n  \"targetPrice\": 999999.00,\n  \"direction\": \"BELOW\"\n}"
            }
          }
        },
        {
          "name": "3 - Create Alert (Validation: invalid direction)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('success is false', () => pm.expect(pm.response.json().success).to.be.false);",
                  "pm.test('message mentions direction', () => pm.expect(pm.response.json().message).to.include('direction'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/alerts",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{aaravId}}\",\n  \"symbol\": \"RELIANCE\",\n  \"targetPrice\": 2500.00,\n  \"direction\": \"SIDEWAYS\"\n}"
            }
          }
        },
        {
          "name": "4 - Create Alert (Validation: unsupported symbol)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('success is false', () => pm.expect(pm.response.json().success).to.be.false);",
                  "pm.test('message mentions symbol', () => pm.expect(pm.response.json().message).to.include('not supported'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/alerts",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{aaravId}}\",\n  \"symbol\": \"DOGECOIN\",\n  \"targetPrice\": 1.00,\n  \"direction\": \"ABOVE\"\n}"
            }
          }
        },
        {
          "name": "5 - Get Active Alerts (Aarav - should have TCS alert)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('success is true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('data is an array', () => pm.expect(pm.response.json().data).to.be.an('array'));",
                  "pm.test('at least 1 alert', () => pm.expect(pm.response.json().data.length).to.be.at.least(1));",
                  "pm.test('all alerts are active', () => pm.response.json().data.forEach(a => pm.expect(a.isActive).to.be.true));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/alerts/{{aaravId}}"
          }
        },
        {
          "name": "6 - Get Active Alerts (empty user - returns empty array)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('data is empty array', () => pm.expect(pm.response.json().data).to.be.an('array').that.is.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/alerts/00000000-0000-0000-0000-000000000000"
          }
        },
        {
          "name": "7 - Wait for auto-trigger (sleep 4s via pre-request)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const waitMs = 4000;",
                  "const start = Date.now();",
                  "while (Date.now() - start < waitMs) {}",
                  "console.log('Waited 4s for price tick to trigger alert');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Trigger-wait ping is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Feed is running (mode=SIMULATION)', () => pm.expect(pm.response.json().data.mode).to.equal('SIMULATION'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/market/feed-status"
          }
        },
        {
          "name": "8 - Verify auto-triggered BELOW alert gone from Priya active list",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const alerts = pm.response.json().data;",
                  "pm.test('RELIANCE BELOW 999999 not in active list (auto-triggered)', () => {",
                  "  const found = alerts.find(a => a.symbol === 'RELIANCE' && a.targetPrice === 999999 && a.direction === 'BELOW');",
                  "  pm.expect(found).to.be.undefined;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/alerts/{{priyaId}}"
          }
        },
        {
          "name": "9 - Cancel Alert (soft delete)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('success is true', () => pm.expect(pm.response.json().success).to.be.true);",
                  "pm.test('message is cancelled', () => pm.expect(pm.response.json().message).to.include('cancelled'));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/alerts/{{cancelId}}"
          }
        },
        {
