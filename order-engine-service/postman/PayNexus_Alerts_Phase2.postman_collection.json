{"info":{"name":"PayNexus - Order Engine Phase 2 (Price Alerts)","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json","description":"Phase 2: Price Alerts Engine — create, list, cancel alerts and verify auto-trigger behaviour"},"variable":[{"key":"baseUrl","value":"http://localhost:8083"},{"key":"aaravId","value":"b595ea4c-4baa-48a0-84ec-b4dfc272c47c"},{"key":"priyaId","value":"672cc9ab-3c63-4c28-935e-271b58899a1c"},{"key":"alertId","value":""},{"key":"cancelId","value":""}],"item":[{"name":"1 - Create Alert (ABOVE - never triggers)","event":[{"listen":"test","script":{"exec":["pm.test(\u0027Status is 201\u0027, () =\u003e pm.response.to.have.status(201));","pm.test(\u0027success is true\u0027, () =\u003e pm.expect(pm.response.json().success).to.be.true);","pm.test(\u0027data.alertId exists\u0027, () =\u003e pm.expect(pm.response.json().data.alertId).to.be.a(\u0027string\u0027));","pm.test(\u0027direction is ABOVE\u0027, () =\u003e pm.expect(pm.response.json().data.direction).to.equal(\u0027ABOVE\u0027));","pm.test(\u0027isActive is true\u0027, () =\u003e pm.expect(pm.response.json().data.isActive).to.be.true);","pm.collectionVariables.set(\u0027alertId\u0027, pm.response.json().data.alertId);","pm.collectionVariables.set(\u0027cancelId\u0027, pm.response.json().data.alertId);"]}}],"request":{"method":"POST","url":"{{baseUrl}}/api/v1/alerts","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"userId\": \"{{aaravId}}\",\n  \"symbol\": \"TCS\",\n  \"targetPrice\": 999999.00,\n  \"direction\": \"ABOVE\"\n}"}}},{"name":"2 - Create Alert (BELOW - auto-triggers immediately)","event":[{"listen":"test","script":{"exec":["pm.test(\u0027Status is 201\u0027, () =\u003e pm.response.to.have.status(201));","pm.test(\u0027success is true\u0027, () =\u003e pm.expect(pm.response.json().success).to.be.true);","pm.test(\u0027symbol is RELIANCE\u0027, () =\u003e pm.expect(pm.response.json().data.symbol).to.equal(\u0027RELIANCE\u0027));","pm.test(\u0027direction is BELOW\u0027, () =\u003e pm.expect(pm.response.json().data.direction).to.equal(\u0027BELOW\u0027));","pm.collectionVariables.set(\u0027triggerAlertId\u0027, pm.response.json().data.alertId);"]}}],"request":{"method":"POST","url":"{{baseUrl}}/api/v1/alerts","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"userId\": \"{{priyaId}}\",\n  \"symbol\": \"RELIANCE\",\n  \"targetPrice\": 999999.00,\n  \"direction\": \"BELOW\"\n}"}}},{"name":"3 - Create Alert (Validation: invalid direction)","event":[{"listen":"test","script":{"exec":["pm.test(\u0027Status is 400\u0027, () =\u003e pm.response.to.have.status(400));","pm.test(\u0027success is false\u0027, () =\u003e pm.expect(pm.response.json().success).to.be.false);","pm.test(\u0027message mentions direction\u0027, () =\u003e pm.expect(pm.response.json().message).to.include(\u0027direction\u0027));"]}}],"request":{"method":"POST","url":"{{baseUrl}}/api/v1/alerts","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"userId\": \"{{aaravId}}\",\n  \"symbol\": \"RELIANCE\",\n  \"targetPrice\": 2500.00,\n  \"direction\": \"SIDEWAYS\"\n}"}}},{"name":"4 - Create Alert (Validation: unsupported symbol)","event":[{"listen":"test","script":{"exec":["pm.test(\u0027Status is 400\u0027, () =\u003e pm.response.to.have.status(400));","pm.test(\u0027success is false\u0027, () =\u003e pm.expect(pm.response.json().success).to.be.false);","pm.test(\u0027message mentions symbol\u0027, () =\u003e pm.expect(pm.response.json().message).to.include(\u0027not supported\u0027));"]}}],"request":{"method":"POST","url":"{{baseUrl}}/api/v1/alerts","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\n  \"userId\": \"{{aaravId}}\",\n  \"symbol\": \"DOGECOIN\",\n  \"targetPrice\": 1.00,\n  \"direction\": \"ABOVE\"\n}"}}},{"name":"5 - Get Active Alerts (Aarav - should have TCS alert)","event":[{"listen":"test","script":{"exec":["pm.test(\u0027Status is 200\u0027, () =\u003e pm.response.to.have.status(200));","pm.test(\u0027success is true\u0027, () =\u003e pm.expect(pm.response.json().success).to.be.true);","pm.test(\u0027data is an array\u0027, () =\u003e pm.expect(pm.response.json().data).to.be.an(\u0027array\u0027));","pm.test(\u0027at least 1 alert\u0027, () =\u003e pm.expect(pm.response.json().data.length).to.be.at.least(1));","pm.test(\u0027all alerts are active\u0027, () =\u003e pm.response.json().data.forEach(a =\u003e pm.expect(a.isActive).to.be.true));"]}}],"request":{"method":"GET","url":"{{baseUrl}}/api/v1/alerts/{{aaravId}}"}},{"name":"6 - Get Active Alerts (empty user - returns empty array)","event":[{"listen":"test","script":{"exec":["pm.test(\u0027Status is 200\u0027, () =\u003e pm.response.to.have.status(200));","pm.test(\u0027data is empty array\u0027, () =\u003e pm.expect(pm.response.json().data).to.be.an(\u0027array\u0027).that.is.empty);"]}}],"request":{"method":"GET","url":"{{baseUrl}}/api/v1/alerts/00000000-0000-0000-0000-000000000000"}},{"name":"7 - Wait for auto-trigger (sleep 4s via pre-request)","event":[{"listen":"prerequest","script":{"exec":["const waitMs = 4000;","const start = Date.now();","while (Date.now() - start \u003c waitMs) {}","console.log(\u0027Waited 4s for price tick to trigger alert\u0027);"]}},{"listen":"test","script":{"exec":["pm.test(\u0027Trigger-wait ping is 200\u0027, () =\u003e pm.response.to.have.status(200));","pm.test(\u0027Feed is running (mode=SIMULATION)\u0027, () =\u003e pm.expect(pm.response.json().data.mode).to.equal(\u0027SIMULATION\u0027));"]}}],"request":{"method":"GET","url":"{{baseUrl}}/api/v1/market/feed-status"}},{"name":"8 - Verify auto-triggered BELOW alert gone from Priya active list","event":[{"listen":"test","script":{"exec":["pm.test(\u0027Status is 200\u0027, () =\u003e pm.response.to.have.status(200));","const alerts = pm.response.json().data;","pm.test(\u0027RELIANCE BELOW 999999 not in active list (auto-triggered)\u0027, () =\u003e {","  const found = alerts.find(a =\u003e a.symbol === \u0027RELIANCE\u0027 \u0026\u0026 a.targetPrice === 999999 \u0026\u0026 a.direction === \u0027BELOW\u0027);","  pm.expect(found).to.be.undefined;","});"]}}],"request":{"method":"GET","url":"{{baseUrl}}/api/v1/alerts/{{priyaId}}"}},{"name":"9 - Cancel Alert (soft delete)","event":[{"listen":"test","script":{"exec":["pm.test(\u0027Status is 200\u0027, () =\u003e pm.response.to.have.status(200));","pm.test(\u0027success is true\u0027, () =\u003e pm.expect(pm.response.json().success).to.be.true);","pm.test(\u0027message is cancelled\u0027, () =\u003e pm.expect(pm.response.json().message).to.include(\u0027cancelled\u0027));"]}}],"request":{"method":"DELETE","url":"{{baseUrl}}/api/v1/alerts/{{cancelId}}"}},{"name":"10 - Cancel Already Inactive Alert (400)","event":[{"listen":"test","script":{"exec":["pm.test(\u0027Status is 400\u0027, () =\u003e pm.response.to.have.status(400));","pm.test(\u0027success is false\u0027, () =\u003e pm.expect(pm.response.json().success).to.be.false);","pm.test(\u0027message mentions already inactive\u0027, () =\u003e pm.expect(pm.response.json().message).to.include(\u0027already inactive\u0027));"]}}],"request":{"method":"DELETE","url":"{{baseUrl}}/api/v1/alerts/{{cancelId}}"}},{"name":"11 - Cancel Non-existent Alert (404)","event":[{"listen":"test","script":{"exec":["pm.test(\u0027Status is 404\u0027, () =\u003e pm.response.to.have.status(404));","pm.test(\u0027success is false\u0027, () =\u003e pm.expect(pm.response.json().success).to.be.false);","pm.test(\u0027message mentions Alert not found\u0027, () =\u003e pm.expect(pm.response.json().message).to.include(\u0027Alert not found\u0027));"]}}],"request":{"method":"DELETE","url":"{{baseUrl}}/api/v1/alerts/00000000-0000-0000-0000-000000000000"}},{"name":"12 - Verify Aarav alerts empty after cancel","event":[{"listen":"test","script":{"exec":["pm.test(\u0027Status is 200\u0027, () =\u003e pm.response.to.have.status(200));","pm.test(\u0027No active TCS alert for Aarav\u0027, () =\u003e {","  const tcsAlert = pm.response.json().data.find(a =\u003e a.symbol === \u0027TCS\u0027);","  pm.expect(tcsAlert).to.be.undefined;","});"]}}],"request":{"method":"GET","url":"{{baseUrl}}/api/v1/alerts/{{aaravId}}"}}]}