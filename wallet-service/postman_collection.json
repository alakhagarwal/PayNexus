              "raw": "{{base_url}}/api/v1/users/login"
            },
            "description": "Validates credentials. Returns userId in V1.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aarav.sharma@paynexus.io\",\n  \"password\": \"SecurePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
