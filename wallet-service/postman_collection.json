        {
          "name": "3. Credit Wallet (Stock SELL Payout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/internal/wallet/credit"
            },
            "description": "Credits wallet upon successful stock sale.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{aarav_user_id}}\",\n  \"amount\": 1000.0,\n  \"referenceId\": \"{{credit_ref_id}}\",\n  \"narration\": \"Stock SELL execution payout\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
