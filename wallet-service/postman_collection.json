          "name": "2. Release Funds (Stock BUY Compensation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/internal/wallet/release"
            },
            "description": "Returns held funds back to available balance when stock order fails.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{aarav_user_id}}\",\n  \"amount\": 500.0,\n  \"referenceId\": \"{{hold_ref_id}}\"\n}",
              "options": {
