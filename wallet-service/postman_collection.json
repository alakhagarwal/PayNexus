        {
          "name": "4. P2P Transfer (Aarav -> Priya \u20b9100)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Idempotency-Key",
                "value": "{{transfer_idem_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/wallet/transfer"
            },
            "description": "Executes P2P transfer with Redisson MultiLock and double-entry ledger debit & credit.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderId\": \"{{aarav_user_id}}\",\n  \"receiverId\": \"{{priya_user_id}}\",\n  \"amount\": 100.0,\n  \"transactionPin\": \"{{aarav_pin}}\",\n  \"idempotencyKey\": \"{{transfer_idem_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('transfer_idem_key', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Transfer successful\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Guard Test: Frozen Wallet Transfer (Expects 403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Idempotency-Key",
                "value": "{{frozen_idem_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/wallet/transfer"
            },
            "description": "Verifies that transfers from frozen wallets are blocked.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderId\": \"{{vikram_user_id}}\",\n  \"receiverId\": \"{{aarav_user_id}}\",\n  \"amount\": 500.0,\n  \"transactionPin\": \"554433\",\n  \"idempotencyKey\": \"{{frozen_idem_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('frozen_idem_key', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 403 Forbidden\", function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "pm.test(\"Error message mentions frozen\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.false;",
                  "    pm.expect(res.message.toLowerCase()).to.include(\"frozen\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Guard Test: Incorrect Transaction PIN (Expects 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Idempotency-Key",
                "value": "{{wrong_pin_idem_key}}",
                "type": "text"
