{
  "info": {
    "name": "PayNexus - Wallet Service",
    "description": "Comprehensive Postman test suite for PayNexus Wallet Service and API Gateway.\n\nModules Covered:\n1. User Management & Auth\n2. Wallet Operations & P2P MultiLock Transfers\n3. Payment Gateway Integration\n4. Admin Operations (KYC & Account Freezes)\n5. Internal Inter-Service Saga Operations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. User Management",
      "item": [
        {
          "name": "1. Register User (Atomic User + Wallet)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/users/register"
            },
            "description": "Creates a new user account and linked wallet atomically.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Karan Mehra\",\n  \"email\": \"karan.mehra_{{$randomInt}}@paynexus.io\",\n  \"password\": \"SecurePass123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"User and Wallet IDs returned\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data.userId).to.be.a('string');",
                  "    pm.expect(res.data.walletId).to.be.a('string');",
                  "    pm.environment.set(\"registered_user_id\", res.data.userId);",
                  "});"
                ]
              }
            }
          ]
        },
        {
