    {
      "name": "5. Internal Inter-Service",
      "item": [
        {
          "name": "1. Hold Funds (Stock BUY Saga - Step 1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/internal/wallet/hold"
            },
            "description": "Reserves funds by moving amount from availableBalance to reservedBalance.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{aarav_user_id}}\",\n  \"amount\": 500.0,\n  \"referenceId\": \"{{hold_ref_id}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('hold_ref_id', 'saga_hold_' + pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Hold succeeded\", function () {",
                  "    var res = pm.response.json();",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data.holdId).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
