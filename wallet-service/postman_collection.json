              "raw": "{{base_url}}/api/v1/wallet/transfer"
            },
            "description": "Verifies that incorrect transaction PIN triggers 401 Unauthorized.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senderId\": \"{{aarav_user_id}}\",\n  \"receiverId\": \"{{priya_user_id}}\",\n  \"amount\": 50.0,\n  \"transactionPin\": \"000000\",\n  \"idempotencyKey\": \"{{wrong_pin_idem_key}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('wrong_pin_idem_key', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 401 Unauthorized\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
