# =============================================================================
# PayNexus Environment Configuration
# =============================================================================

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=paynexus_wallet

# Redis Configuration (Distributed Locks, Caching, Idempotency)
REDIS_HOST=localhost
REDIS_PORT=6379

# Eureka Service Discovery
EUREKA_HOST=localhost
EUREKA_PORT=8761

# Kafka Event Bus
KAFKA_BROKER=localhost:9092

# Razorpay Sandbox Credentials (Replace with test credentials from Razorpay Dashboard)
RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=dummy_secret
RAZORPAY_WEBHOOK_SECRET=dummy_webhook_secret
